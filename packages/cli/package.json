{
  "name": "@tp-scroll/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "tp-scroll": "./dist/bin.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --no-error-on-unmatched-pattern src tests",
    "lint:fix": "eslint --fix --no-error-on-unmatched-pattern src tests",
    "test": "vitest run",
    "start": "node --experimental-strip-types src/bin.ts"
  },
  "dependencies": {
    "@tp-scroll/adapter-holidays": "workspace:*",
    "@tp-scroll/adapter-storage": "workspace:*",
    "@tp-scroll/core": "workspace:*",
    "commander": "^13.0.0",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
